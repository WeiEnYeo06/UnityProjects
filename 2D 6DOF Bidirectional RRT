%% RRT_manipulator_6DOF.m  (bidirectional RRT-Connect version)
%
% Why this rewrite: plain single-tree RRT with uniform random sampling
% (the previous version) scales very poorly with configuration-space
% dimension. In testing, it plateaued for 50,000+ iterations without
% ever reaching the goal in 6-D, even though the goal is provably
% reachable (verified separately with a probabilistic roadmap check --
% start and goal ARE in the same connected free-space region).
%
% The fix: grow TWO trees, one from q_start and one from q_goal, and
% each iteration try to CONNECT them (this is the classic RRT-Connect
% algorithm). This needs vastly fewer iterations in high dimensions
% because both trees are actively reaching toward each other, instead
% of one tree hoping to stumble into a small goal region.
%
% Collision checking is also vectorized (matrix ops instead of nested
% per-link/per-obstacle function calls), which further cuts runtime.
%
% No toolboxes required - pure base MATLAB.

clear; clc; close all;
rng(1);

%% ------------------------- Robot parameters -------------------------
numLinks = 6;
L = ones(1, numLinks) * (2/numLinks);   % total reach = 2.0 (same as before)

%% ------------------------- Configuration space ------------------------
qmin = -pi * ones(1, numLinks);
qmax =  pi * ones(1, numLinks);

%% ------------------------- Start / goal --------------------------------
q_start = zeros(1, numLinks);
q_start(1) = -pi/2;

q_goal = zeros(1, numLinks);
q_goal(1) = pi/6;
q_goal(2) = pi/12;
q_goal(3) = -pi/3;

%% ------------------------- Obstacles (workspace) -----------------------
% UNCHANGED.
obstacles = [ 1.04   1.04   0.25;
             -0.65   1.30   0.20;
              1.30  -0.65   0.20];

%% ------------------------- RRT-Connect parameters ------------------------
K               = 1000;   % max iterations (was 20000 for single-tree; far
                           % fewer needed now -- testing showed convergence
                           % in under 25 iterations for this problem)
stepSize        = 0.20;   % unchanged
maxExtendSteps  = 25;     % unchanged: cap for the "reach toward a random sample" extend
connectCap      = 300;    % NEW: larger cap when greedily connecting the two trees
edgeCheckRes    = 5;      % unchanged
goalTol         = 0.10;   % unchanged: distance counted as "trees connected"

%% ------------------------- Sanity checks ---------------------------------
startBad = isCollision(q_start, L, obstacles);
goalBad  = isCollision(q_goal,  L, obstacles);

if startBad || goalBad
    figure('Name', 'Collision Preview', 'Position', [50 80 480 480]);
    axis equal; hold on; grid on;
    xlim([-2.2 2.2]); ylim([-2.2 2.2]);
    plotObstacles(obstacles);
    if startBad
        plotManipulator(q_start, L, 'r');
        text(0, -1.9, 'START (red) is in collision', 'HorizontalAlignment', 'center', 'Color', 'r');
    end
    if goalBad
        plotManipulator(q_goal, L, 'm');
        text(0, -2.05, 'GOAL (magenta) is in collision', 'HorizontalAlignment', 'center', 'Color', 'm');
    end
    title('Fix q\_start / q\_goal / obstacles, then re-run');
    drawnow;
end
if startBad
    error('Start configuration is in collision with an obstacle. See the Collision Preview figure.');
end
if goalBad
    error('Goal configuration is in collision with an obstacle. See the Collision Preview figure.');
end

%% ------------------------- Initialize two trees -----------------------------
treeA.nodes  = q_start;  treeA.parent = 0;   % starts as the START tree
treeB.nodes  = q_goal;   treeB.parent = 0;   % starts as the GOAL tree
aIsStart = true;

connected  = false;
idxConnA   = -1;
idxConnB   = -1;

fprintf('Building bidirectional RRT-Connect (config-space dim = %d) ...\n', numLinks);
tic;
for k = 1:K

    % --- sample a random state -------------------------------
    q_rand = qmin + rand(1, numLinks) .* (qmax - qmin);

    % --- extend tree A toward the random sample --------------
    [treeA, idxNewA, ~] = extendTree(treeA, q_rand, L, obstacles, ...
                                      stepSize, maxExtendSteps, edgeCheckRes, qmin, qmax);

    if idxNewA ~= -1
        % --- greedily CONNECT tree B all the way toward A's new node ---
        target = treeA.nodes(idxNewA, :);
        [treeB, idxNewB, reachedB] = extendTree(treeB, target, L, obstacles, ...
                                                 stepSize, connectCap, edgeCheckRes, qmin, qmax, goalTol);
        if reachedB
            connected = true;
            idxConnA = idxNewA;
            idxConnB = idxNewB;
            fprintf('Trees connected at iteration %d (sizes: %d + %d = %d nodes)\n', ...
                     k, size(treeA.nodes,1), size(treeB.nodes,1), ...
                     size(treeA.nodes,1)+size(treeB.nodes,1));
            break;
        end
    end

    % --- swap roles for next iteration (keeps both trees growing evenly) ---
    tmp = treeA; treeA = treeB; treeB = tmp;
    aIsStart = ~aIsStart;

    if mod(k, 100) == 0
        fprintf('  iter %4d | tree sizes: %d + %d | elapsed: %.1fs\n', ...
                k, size(treeA.nodes,1), size(treeB.nodes,1), toc);
    end
end
elapsedTime = toc;

if ~connected
    fprintf('Trees NOT connected within %d iterations (%.1fs elapsed).\n', K, elapsedTime);
    fprintf('Try increasing K -- this problem is confirmed reachable (verified separately).\n');
else
    fprintf('Done in %.2f seconds.\n', elapsedTime);
end

%% ------------------------- Extract path (backtrack both trees) ------------------------
path = [];
if connected
    % Backtrack tree A from idxConnA to its root
    pathA = [];
    idx = idxConnA;
    while idx ~= 0
        pathA = [treeA.nodes(idx, :); pathA]; %#ok<AGROW>
        idx = treeA.parent(idx);
    end
    % Backtrack tree B from idxConnB to its root
    pathB = [];
    idx = idxConnB;
    while idx ~= 0
        pathB = [treeB.nodes(idx, :); pathB]; %#ok<AGROW>
        idx = treeB.parent(idx);
    end
    % pathA runs root(A) -> connection point A; pathB runs root(B) -> connection point B.
    % Orient so the final path always runs q_start -> q_goal.
    if aIsStart
        path = [pathA; flipud(pathB)];
    else
        path = [pathB; flipud(pathA)];
    end
    fprintf('Path found with %d waypoints.\n', size(path,1));
end

%% ------------------------- Plot: configuration space (projection) ----------
figure('Name', 'RRT-Connect - Configuration Space (theta1-theta2 projection)', ...
       'Position', [50 80 480 480]);
hold on; axis equal; grid on;
if aIsStart
    plotTreeProj(treeA, [0.6 0.8 1.0]);   % start-tree in light blue
    plotTreeProj(treeB, [1.0 0.8 0.6]);   % goal-tree in light orange
else
    plotTreeProj(treeB, [0.6 0.8 1.0]);
    plotTreeProj(treeA, [1.0 0.8 0.6]);
end
plot(q_start(1), q_start(2), 'go', 'MarkerFaceColor', 'g', 'MarkerSize', 9);
plot(q_goal(1),  q_goal(2),  'ro', 'MarkerFaceColor', 'r', 'MarkerSize', 9);
if connected
    plot(path(:,1), path(:,2), 'b-', 'LineWidth', 2);
end
xlabel('\theta_1 (rad)'); ylabel('\theta_2 (rad)');
title({'RRT-Connect trees - projection onto (\theta_1,\theta_2)', ...
       'blue=start-tree, orange=goal-tree (actual trees live in 6-D)'});

%% ------------------------- Plot + animate: workspace ------------------------
figure('Name', 'RRT-Connect - Workspace', 'Position', [560 80 480 480]);
axis equal; hold on; grid on;
xlim([-2.2 2.2]); ylim([-2.2 2.2]);
plotObstacles(obstacles);
title('Workspace: Manipulator Path');
xlabel('x'); ylabel('y');

if connected
    animateManipulator(path, L, obstacles);
else
    plotManipulator(q_start, L, 'k');
end


%% ============================================================
%                       LOCAL FUNCTIONS
% ============================================================

function [tree, idxNew, reachedTarget] = extendTree(tree, target, L, obstacles, ...
                                                      stepSize, maxSteps, edgeCheckRes, qmin, qmax, tol)
% Greedily steer from the nearest node in `tree` toward `target`, adding
% each valid intermediate node, until reaching target (if tol given and
% met), hitting an obstacle, or hitting maxSteps. Returns idxNew = index
% of the last successfully-added node, or -1 if not even one step
% succeeded. reachedTarget is true only if `tol` was supplied and met.
    if nargin < 10
        tol = -1;   % no target-reached check (used for plain "extend toward random sample")
    end

    diffs = tree.nodes - target;
    dists = sum(diffs.^2, 2);
    [~, idxNear] = min(dists);
    q_near = tree.nodes(idxNear, :);

    direction = target - q_near;
    dist = norm(direction);
    if dist > 1e-9
        unitDir = direction / dist;
    else
        unitDir = zeros(1, numel(q_near));
    end

    q_current  = q_near;
    idxCurrent = idxNear;
    reachedTarget = false;
    numSubSteps = min(maxSteps, ceil(dist / stepSize));

    for s = 1:numSubSteps
        remaining = norm(target - q_current);
        thisStep  = min(stepSize, remaining);
        q_candidate = q_current + unitDir * thisStep;
        q_candidate = max(min(q_candidate, qmax), qmin);

        if isEdgeCollision(q_current, q_candidate, L, obstacles, edgeCheckRes)
            break;
        end

        tree.nodes  = [tree.nodes;  q_candidate];
        tree.parent = [tree.parent; idxCurrent];
        idxCurrent  = size(tree.nodes, 1);
        q_current   = q_candidate;

        if tol > 0 && norm(q_current - target) < tol
            reachedTarget = true;
            break;
        end
    end

    if idxCurrent == idxNear
        idxNew = -1;   % no progress at all (blocked on the very first sub-step)
    else
        idxNew = idxCurrent;
    end
end

function positions = forwardKinematicsChain(q, L)
    N = numel(q);
    positions = zeros(N+1, 2);
    cumAngle = 0;
    for i = 1:N
        cumAngle = cumAngle + q(i);
        positions(i+1, :) = positions(i, :) + L(i) * [cos(cumAngle), sin(cumAngle)];
    end
end

function tf = isCollision(q, L, obstacles)
% Vectorized collision check: computes all link segments at once and
% checks each obstacle against all segments in one shot (no per-link,
% per-obstacle function-call overhead).
    positions = forwardKinematicsChain(q, L);
    A = positions(1:end-1, :);   % segment start points, numLinks x 2
    B = positions(2:end,   :);   % segment end points,   numLinks x 2
    AB = B - A;
    denom = sum(AB.^2, 2);
    denom(denom < 1e-12) = 1e-12;

    tf = false;
    for i = 1:size(obstacles, 1)
        c = obstacles(i, 1:2);
        r = obstacles(i, 3);
        t = sum((c - A) .* AB, 2) ./ denom;
        t = min(max(t, 0), 1);
        proj = A + t .* AB;
        d = sqrt(sum((c - proj).^2, 2));
        if any(d <= r)
            tf = true;
            return;
        end
    end
end

function tf = isEdgeCollision(qA, qB, L, obstacles, res)
    tf = false;
    for i = 0:res
        t = i / res;
        q = qA + t * (qB - qA);
        if isCollision(q, L, obstacles)
            tf = true;
            return;
        end
    end
end

function plotTreeProj(tree, color)
% Draw every edge of a tree, projected onto columns 1-2.
    for i = 2:size(tree.nodes, 1)
        p = tree.nodes(tree.parent(i), 1:2);
        c = tree.nodes(i, 1:2);
        plot([p(1) c(1)], [p(2) c(2)], '-', 'Color', color);
    end
end

function plotObstacles(obstacles)
    for i = 1:size(obstacles, 1)
        x = obstacles(i,1); y = obstacles(i,2); r = obstacles(i,3);
        rectangle('Position', [x-r, y-r, 2*r, 2*r], ...
                  'Curvature', [1 1], 'FaceColor', [1 0.6 0.6], 'EdgeColor', 'r');
    end
end

function h = plotManipulator(q, L, color)
    positions = forwardKinematicsChain(q, L);
    h = plot(positions(:,1), positions(:,2), '-o', 'Color', color, ...
             'LineWidth', 3, 'MarkerFaceColor', color);
end

function animateManipulator(path, L, obstacles)
    stepsPerSegment = 5;
    qTraj = path(1, :);
    for i = 1:size(path,1)-1
        for t = linspace(0, 1, stepsPerSegment)
            qTraj = [qTraj; path(i,:) + t*(path(i+1,:) - path(i,:))]; %#ok<AGROW>
        end
    end
    for i = 1:size(qTraj, 1)
        cla;
        plotObstacles(obstacles);
        plotManipulator(qTraj(i,:), L, 'b');
        positions = forwardKinematicsChain(qTraj(i,:), L);
        pEE = positions(end, :);
        plot(pEE(1), pEE(2), 'k.', 'MarkerSize', 8);
        xlim([-2.2 2.2]); ylim([-2.2 2.2]);
        axis equal; grid on;
        title('Workspace: Manipulator Path');
        drawnow;
        pause(0.03);
    end
end
